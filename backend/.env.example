# Postgres connection
DATABASE_URL=postgres://pastoral_app:changeme@localhost:5432/pastoral_care
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# API server
PORT=3000
ALLOWED_ORIGINS=http://localhost:19006,http://localhost:5173

# Auth
JWT_SIGNING_SECRET=replace-with-a-long-random-secret-min-32-bytes

# Field-level encryption master key (32 bytes, base64-encoded).
# Generate with: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=replace-with-a-base64-32-byte-key
